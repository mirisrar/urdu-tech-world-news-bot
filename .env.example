# Copy this file to .env and fill in real values. Never commit .env.

# Supabase
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY is REQUIRED once website RLS is on (anon = read-only).
# Without it the bot cannot save fb_post_id and will DUPLICATE Facebook posts.
# Get it: Supabase → Settings → API → service_role (secret). NEVER put in browser code.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Gemini API (AI processing) — get one at aistudio.google.com
GEMINI_API_KEY=
# Optional model chain (comma-separated). Default tries primary first every call:
# gemini-3.5-flash-lite → gemini-3.1-flash-lite → gemini-3.6-flash → gemini-2.5-flash → gemini-3-flash
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-2.5-flash,gemini-3-flash

# Schedule tuning (GitHub Actions runs every 10 minutes — see news.yml)
# Pull this many items from each RSS/NewsAPI source, then AI-process only
# URLs not already in the DB, up to MAX_ITEMS_PER_RUN.
# MAX_ITEMS_PER_SOURCE=25
# MAX_ITEMS_PER_RUN=40
# AI_CALL_SPACING_MS=1000
# No fixed default image. Missing cover → Unsplash/Pexels by topic, else skip.
# SKIP_IF_NO_TOPIC_IMAGE=true
# STOCK_IMAGE_PROVIDER=auto
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=
#
# Website article links — appended at the bottom of every Facebook post.
# Set WEBSITE_BASE_URL to your live Nexora site (no trailing slash).
# WEBSITE_BASE_URL=https://your-domain.com
# WEBSITE_ARTICLE_PATH=/article.html?id={id}
#
# Phase 9 — scale / dedupe / publish retry
# TITLE_DEDUPE_LOOKBACK=200
# TITLE_SIMILARITY_THRESHOLD=0.72
# PUBLISH_RETRY_LIMIT=10
# PUBLISH_RETRY_LOOKBACK_HOURS=48

# NewsAPI.org (optional additional source) — get a free key at newsapi.org
# If unset, this source is skipped automatically; everything else still works.
NEWS_API_KEY=

# Social Media Publishing (Phase 4, publishers/) — each channel is optional
# and independently skipped if its variables aren't all set. Uncomment and
# fill in only the channels you actually want to use.

# Facebook Graph API — Page access token needs pages_manage_posts.
# Prefer a long-lived Page token (short-lived Explorer tokens expire ~1–2h / ~60d).
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# Website link in FB caption (defaults to https://www.nexoranewsurdu.com)
# WEBSITE_BASE_URL=https://www.nexoranewsurdu.com
# WEBSITE_ARTICLE_PATH=/article.html?id={id}
#
# Facebook native Scheduled (shows under Page → Scheduled)
# Requires facebook-queue.sql migration. First slot >= now+10min (Meta rule).
# FACEBOOK_USE_QUEUE=true
# FACEBOOK_SCHEDULE_GAP_MS=300000
# Max how far ahead new slots may be (hours). Avoids Aug+6 pile-ups.
# FACEBOOK_SCHEDULE_MAX_AHEAD_HOURS=12
# FACEBOOK_MAX_SCHEDULES_PER_RUN=10
# FACEBOOK_PAUSE_UNTIL=   # leave unset/empty to post now
# FACEBOOK_MAX_POSTS_PER_DAY=288
# FACEBOOK_MAX_POSTS_PER_RUN=1
# FACEBOOK_MIN_GAP_MS=300000
# FACEBOOK_POST_INTERVAL_MS=0
# Catch-up into schedule. 0 = off. MIN_NEWS_ID = only from that id upward.
# FACEBOOK_QUEUE_BACKFILL_LIMIT=20
# FACEBOOK_QUEUE_BACKFILL_MIN_NEWS_ID=4540
# Only cancel stale pending below MIN_NEWS_ID (hours). Catch-up ids are kept.
# FACEBOOK_QUEUE_RETRY_MAX_AGE_HOURS=48
#
# Important-news filter (Feed). Default ON — live workflow uses true.
# FACEBOOK_IMPORTANT_ONLY=true
# FACEBOOK_IMPORTANT_CATEGORIES=Pakistan,Politics,World
# Same calendar day only (default ON). Yesterday is never scheduled after midnight.
# FACEBOOK_SAME_DAY_ONLY=true
# FACEBOOK_TIMEZONE=Asia/Karachi
# FACEBOOK_MAX_AGE_HOURS=24
#
# Page Photo Stories — DISABLED (causes Graph API error 200 / permissions).
# Do not set FACEBOOK_STORIES_ENABLED=true unless Meta Stories are fully approved.
# FACEBOOK_STORIES_ENABLED=false
# FACEBOOK_MAX_STORIES_PER_RUN=5

# Telegram Bot API — bot must be added to the channel as an admin
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Outbound channel posts (scrape → Telegram/X). Default OFF.
# PUBLISH_TELEGRAM=false
# PUBLISH_X=false
# Editor ingest via GitHub Actions polling (photo + caption).
# Get your id: message @userinfobot then put numbers here (comma-separated).
# TELEGRAM_EDITOR_IDS=123456789,987654321
# TELEGRAM_INGEST_ENABLED=true
# TELEGRAM_PUBLISH_MAX_PER_RUN=5
# Run SQL: website-integration/database/telegram-inbox.sql
# Phase 8 run-health alerts (optional). Same bot token; alert chat can be a
# private ops chat. Mode: always | failures | off (default always).
# TELEGRAM_ALERT_CHAT_ID=
# TELEGRAM_ALERT_MODE=always

# X (Twitter) API v2 — OAuth1.0a consumer + access token/secret pair
# (from the X Developer Portal; write access requires OAuth1.0a, not a
# plain bearer token)
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=

# WhatsApp Business Cloud API — sends pre-approved TEMPLATE messages to
# opted-in recipients (NOT a public "WhatsApp Channel" broadcast — see
# publishers/whatsapp.js for why). WHATSAPP_RECIPIENT_NUMBERS is a
# comma-separated list of E.164 numbers, e.g. "+923001234567,+923009876543".
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_RECIPIENT_NUMBERS=

# Original article images (no AI / Pollinations generation)
# Optional: re-host originals in Supabase Storage (public bucket).
# SUPABASE_STORAGE_BUCKET=news-images
# Used only when RSS + og:image / twitter:image extraction all fail.
# Optional — last-resort ONLY if unique category pools somehow fail.
# Prefer leaving unset: bot uses unique per-article category stock covers.
# Do NOT set this to a single Unsplash URL for all posts (causes identical cards).
# DEFAULT_FALLBACK_IMAGE_URL=
