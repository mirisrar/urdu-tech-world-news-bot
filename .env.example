# Copy this file to .env and fill in real values. Never commit .env.

# Supabase
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY is REQUIRED once website RLS is on (anon = read-only).
# Without it the bot cannot save fb_post_id and will DUPLICATE Facebook posts.
# Get it: Supabase → Settings → API → service_role (secret). NEVER put in browser code.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Gemini API (AI processing) — get one at aistudio.google.com
GEMINI_API_KEY=

# Schedule tuning (GitHub Actions runs every 10 minutes — see news.yml)
# Pull this many items from each RSS/NewsAPI source, then AI-process only
# URLs not already in the DB, up to MAX_ITEMS_PER_RUN.
# MAX_ITEMS_PER_SOURCE=25
# MAX_ITEMS_PER_RUN=40
# AI_CALL_SPACING_MS=1000
#
# Phase 9 — scale / dedupe / publish retry
# TITLE_DEDUPE_LOOKBACK=200
# TITLE_SIMILARITY_THRESHOLD=0.72
# PUBLISH_RETRY_LIMIT=10
# PUBLISH_RETRY_LOOKBACK_HOURS=48

# NewsAPI.org (optional additional source) — get a free key at newsapi.org
# If unset, this source is skipped automatically; everything else still works.
NEWS_API_KEY=

# Social Media Publishing (Phase 4, publishers/) — each channel is optional
# and independently skipped if its variables aren't all set. Uncomment and
# fill in only the channels you actually want to use.

# Facebook Graph API — Page access token needs pages_manage_posts.
# Prefer a long-lived Page token (short-lived Explorer tokens expire ~1–2h / ~60d).
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# Cool-down / daily pacing (after spam flags):
# FACEBOOK_PAUSE_UNTIL=2026-08-01T10:43:20Z
# FACEBOOK_MAX_POSTS_PER_DAY=6
# FACEBOOK_MAX_POSTS_PER_RUN=1
# FACEBOOK_MIN_GAP_MS=14400000
# FACEBOOK_POST_INTERVAL_MS=0

# Telegram Bot API — bot must be added to the channel as an admin
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Phase 8 run-health alerts (optional). Same bot token; alert chat can be a
# private ops chat. Mode: always | failures | off (default always).
# TELEGRAM_ALERT_CHAT_ID=
# TELEGRAM_ALERT_MODE=always

# X (Twitter) API v2 — OAuth1.0a consumer + access token/secret pair
# (from the X Developer Portal; write access requires OAuth1.0a, not a
# plain bearer token)
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=

# WhatsApp Business Cloud API — sends pre-approved TEMPLATE messages to
# opted-in recipients (NOT a public "WhatsApp Channel" broadcast — see
# publishers/whatsapp.js for why). WHATSAPP_RECIPIENT_NUMBERS is a
# comma-separated list of E.164 numbers, e.g. "+923001234567,+923009876543".
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_RECIPIENT_NUMBERS=

# Original article images (no AI / Pollinations generation)
# Optional: re-host originals in Supabase Storage (public bucket).
# SUPABASE_STORAGE_BUCKET=news-images
# Used only when RSS + og:image / twitter:image extraction all fail.
# Optional — last-resort ONLY if unique category pools somehow fail.
# Prefer leaving unset: bot uses unique per-article category stock covers.
# Do NOT set this to a single Unsplash URL for all posts (causes identical cards).
# DEFAULT_FALLBACK_IMAGE_URL=
